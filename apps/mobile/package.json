{
  "name": "@kenoracric/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "pnpm --filter @kenoracric/mobile... build && pnpm --filter @kenoracric/mobile exec expo start",
    "android": "pnpm --filter @kenoracric/mobile... build && pnpm --filter @kenoracric/mobile exec expo start --android",
    "typecheck": "pnpm --filter @kenoracric/mobile... build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kenoracric/api-client": "workspace:*",
    "@kenoracric/contracts": "workspace:*",
    "@kenoracric/cricket-engine": "workspace:*",
    "expo": "~52.0.27",
    "expo-router": "~4.0.17",
    "expo-sqlite": "~15.1.2",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "socket.io-client": "^4.8.1",
    "react-native": "0.76.6"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.3"
  }
}
